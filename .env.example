# OpenRouter (LLM): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug from https://openrouter.ai/models, swap freely, no code change needed
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Where SQLite + Baileys auth session files live. Defaults to ./data if unset.
DATA_DIR=./data

# What the assistant calls itself by default. Each user can rename it later
# just by telling it to (e.g. "call yourself Nova"), this only sets the
# out-of-the-box name.
DEFAULT_ASSISTANT_NAME=Flint

# Groq (speech-to-text, free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Text-to-speech via Microsoft Edge's free neural voices (no key needed).
# Browse voice names: npx tsx -e "import {listVoices} from 'edge-tts-universal'; console.log(await listVoices())"
EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural

# Max USD of OpenRouter spend per non-owner user per day before they get a
# "come back tomorrow" reply instead of a real one. The owner is never capped.
DAILY_COST_CAP_USD=2.00
